root = true

[**]
charset=utf-8
trim_trailing_whitespace = true
insert_final_newline = false
indent_size = 4
tab_width = 4
indent_style = tab

[**.{yml,yaml}]
indent_style = space
indent_size = 2
tab_width = 2

[**.{py,rpy}]
indent_style = space

[**.md]
trim_trailing_whitespace = false # Markdown uses 2 spaces on end of line as line terminator