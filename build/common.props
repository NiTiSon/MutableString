<Project InitialTargets="MutableString_SetIcon">
	<PropertyGroup>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Authors>NiTiSon and contributors</Authors>
		<PackageTags>$(PackageTags);string;mutable;fast</PackageTags>
		<Description>Mutable string implementation</Description>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<TargetFrameworks>net9.0;net6.0</TargetFrameworks>

		<PackageOutputPath>$(MSBuildThisFileDirectory)/../outPackages</PackageOutputPath>

		<LangVersion>latest</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>NiTiS</RootNamespace>

		<VersionPrefix>0.1</VersionPrefix>

		<NoWarn>$(NoWarn);IDE0290;IDE0305</NoWarn>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net7.0'))">
		<IsAotCompatible>true</IsAotCompatible>
		<EnableAotAnalyzer>true</EnableAotAnalyzer>
	</PropertyGroup>


	<PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
		<IsTrimmable>true</IsTrimmable>
		<EnableTrimAnalyzer>true</EnableTrimAnalyzer>
		<TrimMode>full</TrimMode>
	</PropertyGroup>

	<PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>


	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All"/>
	</ItemGroup>

	<!-- Setup the icon for libraries -->
	<Target Name="MutableString_SetIcon">
		<ItemGroup>
			<None Include="$(MSBuildThisFileDirectory)../public/logo.png" Pack="true" PackagePath="/" />
		</ItemGroup>
		<PropertyGroup>
			<PackageIcon>logo.png</PackageIcon>
		</PropertyGroup>
	</Target>
</Project>